# Non-secret org-specific values for sanitization.
# Source this file before running .github/scripts/sanitize.sh locally.
# Secret values (CHANGEME_*) must be set separately — never commit them here.

# GitHub org / username used in git SSH URLs
GIT_ORG=blediagolli

# Original upstream org referenced in documentation
UPSTREAM_ORG=albertogd

# Hub (management) cluster app domain
HUB_CLUSTER_DOMAIN=acm-hub.sandbox1269.opentlc.com

# Base domain for dev managed clusters
DEV_BASE_DOMAIN=sandbox1269.opentlc.com

# Admin email used in cert-manager issuers, notifications
USER_EMAIL=bagolli@redhat.com

# AWS Route53 hosted zone ID
HOSTED_ZONE_ID=Z1017727P1RV1ZA608IX

# cert-manager ClusterIssuer name on the hub
CLUSTER_ISSUER_NAME=letsencrypt

# Default StorageClass on the hub cluster
HUB_STORAGE_CLASS=gp3-csi

# S3 bucket for the internal image registry
IMAGE_REGISTRY_BUCKET=aws-test-wtxdp-image-registry-us-east-2
