# Fleet-wide defaults for the attest policies. Rendered into the ConfigMap
# "policy-config" in open-cluster-management-policies by
# policies/stable/cluster-config-maps, and read by hub templates at propagation
# time with fromConfigMap.
#
# KEY=value, one per line. Flat and stringly-typed on purpose: ACM's template
# engine has no fromYaml (it is a Helm function, not a sprig one), so a nested
# YAML blob stuffed into a ConfigMap key could not be parsed on the hub. A value
# that has to be a list is written as a JSON array and converted with toLiteral.
#
# Keys must be valid ConfigMap keys: [-._a-zA-Z0-9]+. No slashes.

# Attested by policies/stable/etcd-encryption. Written by openshift-apiserver.
etcdEncryptionType=aescbc

# Attested by policies/stable/image-registries. Written by openshift-image.
# JSON array -- see the hub template in that policy's manifest.
allowedRegistries=["registry.redhat.io","quay.io","registry.access.redhat.com","image-registry.openshift-image-registry.svc:5000"]
