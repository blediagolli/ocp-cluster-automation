#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-common.sh"

ensure_request_file
require_command codex

if [ ! -f "$REVIEW_FILE" ]; then
  "$ROOT_DIR/scripts/ai-review"
fi

cd "$ROOT_DIR"

codex exec --cd "$ROOT_DIR" --output-last-message "$FIX_FILE" "$(cat <<PROMPT
You are the implementation agent for this repository.

Read .ai-work/review.md and fix only substantiated, actionable findings.
Do not expand scope.
If the review has no actionable findings, do not make code changes.

Afterward, run relevant validation, including make validate when local tools are available.

In your final response, include:
- Findings fixed
- Findings intentionally not fixed and why
- Validation commands and results

Request:

$(cat "$REQUEST_FILE")

Review:

$(cat "$REVIEW_FILE")
PROMPT
)"

print_next_file "Codex fix report" "$FIX_FILE"
