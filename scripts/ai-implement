#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-common.sh"

ensure_request_file
require_command codex

if [ ! -f "$PLAN_FILE" ]; then
  "$ROOT_DIR/scripts/ai-plan"
fi

cd "$ROOT_DIR"

codex exec --cd "$ROOT_DIR" --output-last-message "$IMPLEMENTATION_FILE" "$(cat <<PROMPT
You are the implementation agent for this repository.

Read:
- .ai-work/request.md
- .ai-work/research.md
- .ai-work/plan.md

Implement the plan. Keep changes scoped. Verify details against the repository instead of blindly trusting the plan.

Required behavior:
- Codex owns implementation edits.
- Preserve existing Helm, Kustomize, ACM, Argo CD, and OpenShift patterns.
- Do not commit real credentials or secret material.
- Run the narrow validation called for by the plan when available.
- Run make validate before finishing when local tools are available.

In your final response, include:
- Summary of changes
- Validation commands and results
- Deviations from the plan
- Follow-up risks or live-cluster checks

Initial request:

$(cat "$REQUEST_FILE")

Claude research:

$(cat "$RESEARCH_FILE")

Claude plan:

$(cat "$PLAN_FILE")
PROMPT
)"

print_next_file "Codex implementation report" "$IMPLEMENTATION_FILE"
