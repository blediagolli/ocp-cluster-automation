#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-common.sh"

ensure_request_file
require_command claude

if [ ! -f "$RESEARCH_FILE" ]; then
  "$ROOT_DIR/scripts/ai-research"
fi

cd "$ROOT_DIR"

claude -p "$(cat <<PROMPT
You are the planning agent for this repository.

Read .ai-work/request.md and .ai-work/research.md.
Do not edit implementation files.
Do not implement the change.

Write a concrete implementation plan for Codex with:
- Goal
- Files to change
- Step-by-step implementation tasks
- Validation commands
- Risks and assumptions
- Review focus for the final diff

The plan must be specific enough for Codex to implement without another research pass, while still allowing Codex to verify details against files.

Request:

$(cat "$REQUEST_FILE")

Research:

$(cat "$RESEARCH_FILE")
PROMPT
)" \
  --permission-mode dontAsk \
  --disallowedTools "Edit,Write" \
  > "$PLAN_FILE"

print_next_file "Claude plan" "$PLAN_FILE"
