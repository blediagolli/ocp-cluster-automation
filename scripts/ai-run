#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ai-common.sh"

ensure_request_file

"$ROOT_DIR/scripts/ai-research"
"$ROOT_DIR/scripts/ai-plan"
"$ROOT_DIR/scripts/ai-implement"
"$ROOT_DIR/scripts/ai-review"

cat <<MSG

AI run complete.

Review .ai-work/review.md.
If it contains actionable findings, run:
  ./scripts/ai-fix
MSG
