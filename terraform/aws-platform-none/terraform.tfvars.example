# Cluster identity
cluster_name = "prod-none"
base_domain  = "sandbox3321.opentlc.com"

# AWS
region = "us-east-2"

# Network
vpc_cidr = "10.0.0.0/16"
# availability_zones = ["us-east-2a", "us-east-2b", "us-east-2c"]

# Nodes — compact 3-node cluster (masters only, no workers)
master_count         = 3
worker_count         = 0
master_instance_type = "m5.xlarge"
root_volume_size     = 120

# SSH — provide either an existing key pair name or public key material
# ssh_key_name   = "my-existing-key"
# ssh_public_key = "ssh-ed25519 AAAA..."

# AMI — leave empty to use latest RHCOS; set to discovery ISO AMI once available
# ami_id = "ami-0123456789abcdef0"

# Extra tags
tags = {
  environment = "prod"
  team        = "platform"
}
